# Required ---------------------------------------------------------------

# Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Neon Postgres connection string (Vercel Marketplace > Neon sets this for you)
DATABASE_URL= postgresql://neondb_owner:npg_l2nsOXUJt8vx@ep-cold-rice-bct9fjzt-pooler.c-16.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Session signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Optional ---------------------------------------------------------------

# MiniMax Anthropic-compatible model (default: MiniMax-M3)
ANTHROPIC_MODEL=MiniMax-M3

# Restrict sign-up to these email domains, comma separated
ALLOWED_EMAIL_DOMAINS=

# Set to "false" to close registration once your team has signed up
REGISTRATION_OPEN=true

# Max LLM calls per user per 24 hours (a full FSD+TSD+SPD run is about 45)
DAILY_GENERATION_LIMIT=300
